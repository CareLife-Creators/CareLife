{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CareLife API",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "carelife-services",
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "CareLife frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev",
        "--",
        "--configLoader",
        "runner",
        "--host",
        "127.0.0.1",
        "--port",
        "5173"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "carelife-services",
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "CareLife: Run full site",
      "dependsOn": [
        "CareLife API",
        "CareLife frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
