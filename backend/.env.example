APP_NAME=CareLife API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database_name>

SECRET_KEY=YOUR_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=30
LICENSE_EXPIRY_REMINDER_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
RESET_LINK_BASE_URL=http://localhost:3000/reset-password

EMAIL_MODE=console
EMAIL_FROM=no-reply@carelife.local
SMTP_PORT=587

# bKash Checkout — use credentials supplied by bKash
BKASH_API_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:8000/donations/bkash/callback
